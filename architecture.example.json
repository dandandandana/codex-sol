    {
      "id": "sol.architecture-change",
      "uid": "1ce8b582",
      "parent": "sol",
      "name": {
        "zh": "变更协调",
        "en": "Change coordination"
      },
      "description": {
        "zh": "显式变更协调、共用范围预检、复核、完成证据及只读状态投影",
        "en": "Explicit change coordination, shared scope preflight, review, completion evidence and read-only state projection"
      },
      "source": [
        {
          "path": "src/architecture/change.mjs"
        }
      ],
      "revision": "3a0950cd68a468445d5a9f7dfc83d523b810f29e",
      "updated_at": "2026-10-04T08:30:50.798Z",
      "fingerprint": "ab878e166be65cd2c52f5867292f2e448726e627e7256eae3126d7569331af30",
      "apis": [
        {
          "protocol": "rpc",
          "path": "ChangeCoordinator",
          "description": {
            "zh": "单一变更登记、绑定写入、前后事实与累计影响、版本绑定复核、有效检查及原子完成发布；工作区租约内执行，取消与失败保留实际结果。",
            "en": "Owns one change, bound writes, before/current impact, version-bound review, cumulative checks and atomic completion under the workspace lease; failures retain actual effects."
          }
        },
        {
          "protocol": "rpc",
          "path": "changeBindingSchema",
          "description": {
            "zh": "changeBindingSchema",
            "en": "changeBindingSchema"
          }
        },
        {
          "protocol": "rpc",
          "path": "changeOpenSchema",
          "description": {
            "zh": "changeOpenSchema",
            "en": "changeOpenSchema"
          }
        },
        {
          "protocol": "rpc",
          "path": "changeReviewSchema",
          "description": {
            "zh": "写后复核 prepare/submit 的严格输入合同；绑定变更、当前复核材料及逐模块、验收与未覆盖项的依据。",
            "en": "Strict prepare/submit contract for post-write review bound to the change, current materials and per-module, acceptance and gap evidence."
          }
        },
        {
          "protocol": "rpc",
          "path": "changeCompleteSchema",
          "description": {
            "zh": "完成收尾严格输入：当前 change 绑定和当前 review_handle。",
            "en": "Strict completion input: the current change binding and review_handle."
          }
        }
      ]
    },
