# MCP server workspace and fixed validation rules (absolute paths).
CODEX_SOL_WORKSPACE=/path/to/project
CODEX_SOL_RULES=/path/to/project/rules.json
# Optional JSON array of generated paths excluded from input snapshots.
# Independent Hook commands do not inherit the MCP server environment; pass this and CODEX_SOL_RULES explicitly for bound Context recovery.
CODEX_SOL_GENERATED_PATHS=[]
# Required for sol_apply_patch: the installed Codex executable, not its .cmd shim.
CODEX_SOL_PATCH_EXECUTABLE=/path/to/codex.exe
# Optional MCP host cancellation bridge: the installed Codex executable, not a shim.
# Set an absolute .exe path to enable; keep empty to preserve the MCP SDK default.
CODEX_SOL_HOST_EXECUTABLE=
# Optional Context responsibility config inside CODEX_SOL_WORKSPACE.
# Empty keeps the original four tools. Example: context.example.json.
# Add architecture.path and role architecture=true inside this JSON to enable indexing.
# Hook commands also need CODEX_SOL_WORKSPACE and this path explicitly; bound sessions additionally need the same CODEX_SOL_RULES and CODEX_SOL_GENERATED_PATHS as MCP.
CODEX_SOL_CONTEXT_RULES=
